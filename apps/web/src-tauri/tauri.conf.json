{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sennet",
  "version": "0.1.0",
  "identifier": "app.sennet.tabletop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Sennet", "width": 1340, "height": 900, "minWidth": 850, "minHeight": 620, "backgroundColor": "#101818" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Game",
    "shortDescription": "Your tabletop. Your rules."
  }
}
